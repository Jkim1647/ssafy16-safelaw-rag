# API 키는 코드에 작성하지 않고 이 파일을 .env로 복사해 설정합니다.
GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_EMBEDDING_MODEL=text-embedding-3-small
# 빠른 모델은 검색어 변환, 더 강한 모델은 최종 답변에 배치할 수 있습니다.
# 검색 모델을 비우면 GMS_CHAT_MODEL, 답변 모델을 비우면 gpt-5.4-mini를 사용합니다.
GMS_CHAT_MODEL=gpt-5-nano
GMS_QUERY_MODEL=
GMS_ANSWER_MODEL=gpt-5.4-mini
LAW_API_OC=

# 청크 크기와 중복 길이(글자 수). 바꾸면 청크 생성·색인 스크립트를 다시 실행해야 합니다.
STATUTE_CHUNK_SIZE=1200
STATUTE_CHUNK_OVERLAP=150
CASE_CHUNK_SIZE=1400
CASE_CHUNK_OVERLAP=180
# 법령·판례를 각각 몇 개까지 근거로 가져올지 정합니다.
RAG_TOP_K=5
# similarity(재정렬 점수 순) 또는 mmr(후보 풀에서 겹치지 않는 근거 우선)
RAG_SEARCH_MODE=similarity
# MMR 후보 풀 크기와 관련성 가중치(1이면 유사도 순서, 0에 가까울수록 다양성 우선)
RAG_MMR_FETCH_K=30
RAG_MMR_LAMBDA=0.5

# 원문 입력과 마스킹 매핑은 로그에 기록하지 않습니다.
APP_ENV=development

